[Unit]
Description=Satellite telemetry on-board simulator
After=network.target

[Service]
Type=simple
User=satellite
Group=satellite
ExecStart=/opt/satellite/onboard 127.0.0.1 5005 0 1000
Restart=on-failure
RestartSec=2

# Basic hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
